# --- Lemonade transport (OpenAI-compatible /v1) ---
# Lemonade is the runtime. Keep it on :13305 so it never collides with a
# separate Ollama install (which uses :11434) — DSA_Agent_II can keep running.
LEMONADE_BASE_URL=http://localhost:13305/v1
LEMONADE_API_KEY=lemonade

# --- Models ---
# iGPU coder (heavy reasoning + tool-calling), served via llama.cpp / ROCm.
AGENT_MODEL=Qwen3-Coder-30B-A3B-Instruct-GGUF
# NPU routing/planning model. After Phase-0 Gate B, set this to the
# Lemonade-managed RyzenAI *Hybrid* model you pulled (e.g. a Qwen3-*-Hybrid).
# Defaults to AGENT_MODEL if left blank so the app runs before the NPU model exists.
ROUTER_MODEL=
PLANNER_MODEL=
# llama.cpp backend for the iGPU model: rocm (stable) or vulkan (faster, leaks
# shared memory on gfx1151 — not recommended).
LLAMACPP_BACKEND=rocm

# --- Generation ---
AGENT_MAX_TOKENS=2048
AGENT_TEMPERATURE=0.1
LEMONADE_TIMEOUT_S=120

# --- Feature toggles ---
ENABLE_PLANNER=0
ENABLE_TTS=1
# TTS (Gate C, confirmed on Lemonade 11.0): pull `kokoro-v1` (0.35 GB, small/fast)
# and set TTS_MODEL below. The default OpenAI path {base}/v1/audio/speech works,
# so LEMONADE_TTS_URL can stay blank. Default voice is fine; TTS_VOICE optional.
# Heavier alternatives: OpenMOSS-TTS (12.5 GB) / MOSS-VoiceGen (7.3 GB, cloning).
LEMONADE_TTS_URL=
TTS_MODEL=kokoro-v1
TTS_VOICE=

# --- RAG ---
CHROMA_PERSIST_DIR=.\rag\chroma_db
EMBED_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# Offline mode — set to 1 after first setup to block outbound HuggingFace calls.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- History (kept separate from DSA_Agent_II so the two never share state) ---
DSA_HISTORY=1
DSA_HISTORY_DB=%USERPROFILE%\.dsa_agent_iii\history.db
DSA_HISTORY_MD_DIR=%USERPROFILE%\Downloads\dsa-iii-history

# --- Databricks (leave blank for mock mode) ---
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=dapi...

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=your_db
SNOWFLAKE_SCHEMA=PUBLIC

# --- AWS ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1

# --- DataHub (leave DATAHUB_GMS_URL blank for mock mode) ---
# GMS base URL, without /api/graphql. OSS quickstart: http://localhost:8080
# DataHub Cloud: https://<tenant>.acryl.io/gms
DATAHUB_GMS_URL=
# Personal access token (Settings > Access Tokens). Optional only when
# metadata-service authentication is disabled (e.g. a default local quickstart).
DATAHUB_GMS_TOKEN=
